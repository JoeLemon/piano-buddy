    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^16.7.1",
    "playwright-core": "^1.64.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
