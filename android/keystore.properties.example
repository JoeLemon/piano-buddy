# 复制成 keystore.properties 后填写，keystore.properties 本身不要提交（已在 .gitignore）。
#
#   cp android/keystore.properties.example android/keystore.properties
#   keytool -genkeypair -v -keystore piano-buddy-release.jks \
#     -alias pianobuddy -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile 相对 android/ 目录（也可以写绝对路径）。jks 文件同样不要提交。
storeFile=piano-buddy-release.jks
storePassword=在此填写
keyAlias=pianobuddy
keyPassword=在此填写
