{
  "name": "piano-buddy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --noEmit && vite build",
    "validate:content": "vite-node scripts/validate-content.ts",
    "build:catalog": "vite-node scripts/build-catalog.ts",
    "import:musicxml": "vite-node scripts/import-musicxml.ts",
    "import:batch": "vite-node scripts/import-batch.ts",
    "export:demo": "vite-node scripts/export-demo-motion.ts",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:install": "playwright-core install chromium",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.6.0",
    "idb": "^8.0.2",
